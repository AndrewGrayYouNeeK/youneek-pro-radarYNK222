# Apple WeatherKit credentials (local dev only — never commit real values)
# Copy to .env and fill in after completing WEATHERKIT.md setup.

# 10-character Team ID from developer.apple.com → Membership
WEATHERKIT_TEAM_ID=

# Key ID from the WeatherKit-enabled .p8 key you create
WEATHERKIT_KEY_ID=

# Services ID you register for WeatherKit REST API (e.g. com.youneek.proradar.weather)
WEATHERKIT_SERVICE_ID=

# Contents of the downloaded AuthKey_XXXXXX.p8 file.
# Paste as one line with \n for line breaks, or use real newlines in quotes.
WEATHERKIT_PRIVATE_KEY=
