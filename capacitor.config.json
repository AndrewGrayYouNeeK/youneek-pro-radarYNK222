{
  "appId": "com.base69facdfe1fbc3700e00a8387.app",
  "appName": "YouNeeK Pro Radar",
  "webDir": "dist",
  "backgroundColor": "#020617",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#020617",
    "scheme": "App"
  },
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#020617",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#020617",
      "overlaysWebView": true
    }
  }
}
