# frozen_string_literal: true

default_platform(:ios)

BUNDLE_ID = "com.base69facdfe1fbc3700e00a8387.app"
ASC_APPLE_ID = "6766993130"
XCODE_PROJECT = File.expand_path("../ios/App/App.xcodeproj", __dir__)
SCHEME = "App"
OUTPUT_DIR = File.expand_path("../ios/App/output", __dir__)
IPA_PATH = File.join(OUTPUT_DIR, "YouNeeKProRadar.ipa")

def auth_xcargs(team_id, key_path)
  [
    "DEVELOPMENT_TEAM=#{team_id}",
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{key_path}",
    "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}"
  ].join(" ")
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Resolve App Store Connect API key from env / GitHub secrets"
  private_lane :asc_api_key do
    key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY_P8")
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: !key_content.include?("BEGIN PRIVATE KEY"),
      duration: 1200,
      in_house: false
    )
  end

  desc "Write AuthKey.p8 for xcodebuild cloud signing (never commit this file)"
  private_lane :write_auth_key do
    key_path = File.expand_path("AuthKey.p8", __dir__)
    content = ENV.fetch("APP_STORE_CONNECT_API_KEY_P8")
    if content.include?("BEGIN PRIVATE KEY")
      File.write(key_path, content)
    else
      require "base64"
      File.write(key_path, Base64.decode64(content))
    end
    ENV["APP_STORE_CONNECT_API_KEY_PATH"] = key_path
    key_path
  end

  desc "Unsigned Release compile for the generic iOS Simulator (no certs)"
  lane :compile_unsigned do
    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      skip_archive: true,
      skip_package_ipa: true,
      skip_codesigning: true,
      destination: "generic/platform=iOS Simulator",
      derived_data_path: File.expand_path("../ios/DerivedData/unsigned", __dir__),
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO"
    )
  end

  desc "Build a signed App Store / TestFlight IPA via automatic + cloud signing"
  lane :build_ipa do
    team_id = ENV.fetch("APPLE_TEAM_ID")
    key = asc_api_key
    key_path = write_auth_key

    update_code_signing_settings(
      use_automatic_signing: true,
      path: XCODE_PROJECT,
      team_id: team_id,
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Development"
    )

    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      output_directory: OUTPUT_DIR,
      output_name: "YouNeeKProRadar.ipa",
      export_method: "app-store",
      skip_profile_detection: true,
      xcargs: auth_xcargs(team_id, key_path),
      export_options: {
        method: "app-store-connect",
        signingStyle: "automatic",
        teamID: team_id,
        stripSwiftSymbols: true,
        uploadSymbols: true
      },
      export_xcargs: auth_xcargs(team_id, key_path),
      api_key: key
    )
  end

  desc "Upload an already-built IPA to TestFlight / App Store Connect"
  lane :upload_ipa do
    key = asc_api_key
    upload_to_testflight(
      api_key: key,
      ipa: IPA_PATH,
      app_identifier: BUNDLE_ID,
      apple_id: ASC_APPLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build the signed IPA and upload it to TestFlight / App Store Connect"
  lane :beta do
    build_ipa
    upload_ipa
  end
end
